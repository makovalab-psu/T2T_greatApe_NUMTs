rule subsample_fastq:
    """
    Subsamples paired-end FASTQ files cleanly using seqtk.
    Using a fixed random seed ensures that matching forward and reverse 
    mate-pairs are identically sampled.
    """
    input:
        r1 = config["paths"]["results"] + "/trimmed/{name}_1.trimmed.fastq.gz",
        r2 = config["paths"]["results"] + "/trimmed/{name}_2.trimmed.fastq.gz"
    output:
        r1 = temp(config["paths"]["results"] + "/trimmed/{name}_1.sampled.fastq.gz"),
        r2 = temp(config["paths"]["results"] + "/trimmed/{name}_2.sampled.fastq.gz")
    params:
        max_reads = int(config["params"]["max_reads"]),
        seed = 100
    shell:
        """
        seqtk sample -s{params.seed} {input.r1} {params.max_reads} | gzip > {output.r1}
        seqtk sample -s{params.seed} {input.r2} {params.max_reads} | gzip > {output.r2}
        """

rule align_raw:
    """
    Runs BWA-MEM on the downsampled FASTQ files.
    Saves progress to an unsorted intermediate BAM.
    """
    input:
        r1 = config["paths"]["results"] + "/trimmed/{name}_1.sampled.fastq.gz",
        r2 = config["paths"]["results"] + "/trimmed/{name}_2.sampled.fastq.gz",
        ref = lambda wc: f"{config['paths']['references']}/{config['species_refs'][NAME_TO_INFO[wc.name][2]]}"
    output:
        bam_raw = temp(config["paths"]["results"] + "/alignments/{name}_raw.bam")
    threads: 
        config["params"]["bwa_threads"]
    resources: 
        mem_mb = config["resources"]["bwa_mem"]
    shell:
        """
        bwa mem -t {threads} \
        -R '@RG\\tID:{wildcards.name}\\tSM:{wildcards.name}' \
        {input.ref} {input.r1} {input.r2} | \
        samtools view -bS - > {output.bam_raw}
        """

rule sort_bam:
    """
    Sorts the completed raw BAM file. 
    Uses 2GB per thread (8GB total for 4 threads) to keep the sort completely in-memory.
    If this step gets interrupted, Snakemake will skip BWA-MEM entirely next time
    and just restart this sorting step (taking only a few minutes).
    """
    input:
        bam_raw = config["paths"]["results"] + "/alignments/{name}_raw.bam"
    output:
        bam = config["paths"]["results"] + "/alignments/{name}_t2t.bam"
    threads: 
        config["params"]["sort_threads"]
    resources: 
        mem_mb = config["resources"]["sort_mem"]
    shell:
        """
        set -o pipefail;
        samtools sort -@ {threads} -m 2G -o {output.bam} {input.bam_raw}
        """

rule index_bam:
    """Creates a .bai index for rapid coordinate-based lookups (required for IGV/GATK)."""
    input:  config["paths"]["results"] + "/alignments/{name}_t2t.bam"
    output: config["paths"]["results"] + "/alignments/{name}_t2t.bam.bai"
    shell:  "samtools index {input}"


"""
Ape Genomics Pipeline: Scalable T2T Alignment
--------------------------------------------
Author: Edmundo Torres-González
Date: April 2026

DESCRIPTION:
This pipeline automates FastQC, MultiQC, and BWA-MEM alignment for massive 
genomic datasets. It is designed to handle nested directory structures while 
filtering for specific species of interest.

WORKFLOW:
1. QC: Runs FastQC on raw reads and aggregates results with MultiQC.
2. Alignment: Maps reads to T2T primate assemblies using BWA-MEM.
3. Post-Processing: Sorts output via samtools and generates BAM indices (.bai).
"""

